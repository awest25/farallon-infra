# Dashboard configuration. In production these are injected by Terraform into
# the container's environment (see acquisition.tf / .env on the VM).
# For local dev, copy to .env.local and fill in.

# Public base domain used to build app links (client-visible).
NEXT_PUBLIC_DOMAIN=alexanderwest.com

# Internal service URLs the status backend probes (server-only).
JELLYFIN_URL=http://10.0.0.33:8096
JELLYSEERR_URL=http://10.0.0.34:5055
SONARR_URL=http://10.0.0.34:8989
RADARR_URL=http://10.0.0.34:7878
PROWLARR_URL=http://10.0.0.34:9696
QBIT_URL=http://10.0.0.34:8080

# API keys for *arr health checks (server-only — never sent to the browser).
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# gluetun control server for VPN exit IP / health.
GLUETUN_URL=http://10.0.0.34:8000
GLUETUN_API_KEY=

# Optional: Mullvad account number to show days-until-expiry on the dashboard.
MULLVAD_ACCOUNT_NUMBER=

# Path (mounted read-only into the container) used for disk + backup checks.
STORAGE_PATH=/mnt/storage

# Percentage at which storage flips the dashboard red.
DISK_WARN_PCT=92
